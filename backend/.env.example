# =========================================================
# Environment variables — copy to `.env` and fill in values.
# NEVER commit the real .env file.
# =========================================================

# ---- App ----
APP_ENV=development            # development | production
DEMO_MODE=true                 # true = run OCR/AI with mock data, no external calls
ALLOWED_ORIGINS=http://localhost:5500,https://your-username.github.io

# ---- Supabase ----
# Frontend-safe (public) — the anon key is designed to be exposed client-side
# and is restricted by Supabase Row Level Security policies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Server-side ONLY — never send this to the browser or commit it.
# It bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI extraction provider ----
# Server-side ONLY. Used by AIExtractionService; never exposed to the frontend.
AI_PROVIDER=anthropic           # anthropic | openai | mock
AI_API_KEY=your-ai-provider-api-key
AI_MODEL=claude-sonnet-4-6

# ---- OCR provider ----
OCR_PROVIDER=tesseract          # tesseract | mock | external
OCR_API_KEY=

# ---- File storage ----
# Supabase Storage bucket used for uploaded source documents.
SUPABASE_STORAGE_BUCKET=documents
MAX_UPLOAD_SIZE_MB=15
